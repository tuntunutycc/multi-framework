# build output
dist/

# generated types / Astro cache
.astro/

# dependencies
node_modules/

# environment variables (never commit secrets)
.env
.env.*
!.env.example

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# macOS
.DS_Store

# IDE
.idea/
.vscode/

# local databases
*.sqlite
*.sqlite3
*.db
data/*.db
data/*.db-*
!data/.gitkeep

# test / coverage
coverage/
.nyc_output/

# tenant image uploads (keep public/uploads/.gitkeep)
public/uploads/**
!public/uploads/.gitkeep
!public/uploads/.gitignore
