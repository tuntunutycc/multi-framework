# Copy to .env for local development, or inject these at runtime in Proxmox LXC / CI.
# Never commit real secrets to Git.

# -----------------------------------------------------------------------------
# Server (Astro @astrojs/node standalone)
# -----------------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=4321

# Public base URL for this deployment (canonical links, cookies, future redirects).
# Example: https://app.example.com or https://sites.example.com
PUBLIC_SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Database (PostgreSQL — required when Drizzle runtime is enabled)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@postgres-host:5432/multi_framework

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
# Long random string for signing session cookies (openssl rand -base64 32)
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: writable directory for Astro filesystem session storage (@astrojs/node).
# Mount a volume in LXC if you need sessions to survive container restarts.
# ASTRO_SESSION_DIR=/var/lib/astro/sessions
