# Copy to .env for local development, or pass via `docker run --env-file`.
# Never commit real secrets to Git.

# -----------------------------------------------------------------------------
# Server (Astro @astrojs/node standalone)
# -----------------------------------------------------------------------------
# IMPORTANT: do NOT set NODE_ENV=production here while using `npm run dev`.
# That loads production React and breaks admin islands (_jsxDEV is not a function).
# Docker / `npm start` already set NODE_ENV=production in the runtime.
HOST=0.0.0.0
PORT=4321
# Public URL clients use (Cloudflare Tunnel HTTPS hostname in production).
# Used for allowedDomains so Astro trusts X-Forwarded-Host / Proto from CF.
PUBLIC_SITE_URL=http://localhost:4321
# Optional comma-separated extra hostnames (supports *.example.com wildcards):
# ALLOWED_HOSTS=app.example.com,*.example.com

# -----------------------------------------------------------------------------
# Database (SQLite file — no separate DB server)
# -----------------------------------------------------------------------------
# Prefer DATABASE_URL. SQLITE_PATH is an equivalent alias (used by Docker defaults).
# Local:     ./data/sqlite.db
# Container: /app/data/sqlite.db  (mount host ./data → /app/data)
DATABASE_URL=./data/sqlite.db
# SQLITE_PATH=./data/sqlite.db

# Initialize once before first run:
#   npm run db:push && npm run seed
# After seed:
#   Super admin:  admin@mydomain.com / password123  → /super-admin
#   Tenant admin: admin@riverside.example / password123 → /admin (/riverside)

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
# Required for production deploys (set a long random value).
# Current sessions use an httpOnly cookie verified against the users table;
# SESSION_SECRET is reserved for future signed-cookie hardening.
SESSION_SECRET=replace-with-a-long-random-secret

# -----------------------------------------------------------------------------
# Uploads (tenant images on disk)
# -----------------------------------------------------------------------------
# Local:     ./public/uploads
# Container: /app/public/uploads  (mount host ./public/uploads → /app/public/uploads)
UPLOADS_DIR=./public/uploads
