# Copy to .env for local development, or pass via `docker run --env-file`.
# Never commit real secrets to Git.

# -----------------------------------------------------------------------------
# Server (Astro @astrojs/node standalone)
# -----------------------------------------------------------------------------
# IMPORTANT: do NOT set NODE_ENV=production here while using `npm run dev`.
# That loads production React and breaks admin islands (_jsxDEV is not a function).
# Docker / `npm start` already set NODE_ENV=production in the runtime.
HOST=0.0.0.0
PORT=4321

# Public base URL for this deployment (canonical links, cookies, future redirects).
PUBLIC_SITE_URL=http://localhost:4321

# -----------------------------------------------------------------------------
# Database (SQLite file — no separate DB server)
# -----------------------------------------------------------------------------
# Relative to process cwd. Docker/LXC: mount a volume at /app/data
SQLITE_PATH=./data/sqlite.db

# Demo admin after `npm run db:seed`:
#   admin@riverside.example / password123
#   public site: /riverside

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: writable directory for Astro filesystem session storage.
# ASTRO_SESSION_DIR=/var/lib/astro/sessions

# -----------------------------------------------------------------------------
# Local image uploads (Proxmox LXC / Docker volume)
# -----------------------------------------------------------------------------
# UPLOADS_DIR=/app/public/uploads
