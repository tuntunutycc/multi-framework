---
import { GalleryBlockSchema, type GalleryBlockProps } from '@/types/blocks';

const { title, items }: GalleryBlockProps = GalleryBlockSchema.parse(Astro.props);
const visible = items.filter((item) => item.imageUrl.trim().length > 0);
---

{
  visible.length > 0 && (
    <section class="bg-background px-6 py-16 text-foreground">
      <div class="mx-auto w-full max-w-(--container-max)">
        {title && (
          <header class="mb-10 max-w-2xl">
            <h2 class="font-heading text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
              {title}
            </h2>
          </header>
        )}

        <ul class="grid grid-cols-1 gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {visible.map((item) => (
            <li class="group flex flex-col">
              <div class="overflow-hidden rounded-lg bg-surface ring-1 ring-border">
                <img
                  src={item.imageUrl}
                  alt={item.caption?.trim() || title || 'Gallery image'}
                  class="aspect-[4/3] w-full object-cover transition duration-300 ease-out group-hover:scale-[1.02]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              {item.caption?.trim() && (
                <p class="mt-3 text-sm leading-snug text-muted">{item.caption}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
