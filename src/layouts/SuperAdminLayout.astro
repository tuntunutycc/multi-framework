---
import '@/styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const email = Astro.locals.session?.email ?? '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-zinc-50 font-sans text-zinc-900 antialiased">
    <a
      href="#super-main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-md focus:bg-zinc-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to dashboard
    </a>
    <div class="flex min-h-screen">
      <aside class="w-56 shrink-0 border-r border-zinc-200 bg-white p-4">
        <p class="text-sm font-semibold tracking-tight">Super Admin</p>
        <p class="mt-1 truncate text-xs text-zinc-500">{email}</p>
        <nav class="mt-6 flex flex-col gap-2 text-sm" aria-label="Super admin">
          <a class="rounded-md px-2 py-1.5 hover:bg-zinc-100" href="/super-admin">Tenants</a>
          <form method="post" action="/api/auth/logout" class="mt-4">
            <button type="submit" class="rounded-md px-2 py-1.5 text-left text-zinc-600 hover:bg-zinc-100">
              Sign out
            </button>
          </form>
        </nav>
      </aside>
      <main id="super-main" class="flex-1 p-8">
        <slot />
      </main>
    </div>
  </body>
</html>
