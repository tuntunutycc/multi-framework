---
import '@/styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Website builder</title>
  </head>
  <body class="flex min-h-screen items-center justify-center bg-zinc-50 font-sans text-zinc-900 antialiased">
    <main class="max-w-md p-8">
      <h1 class="text-2xl font-semibold tracking-tight">Multi-tenant website builder</h1>
      <p class="mt-3 text-sm text-zinc-600">Public tenant sites and the admin CMS live in this Astro app.</p>
      <ul class="mt-8 flex flex-col gap-3 text-sm">
        <li>
          <a class="underline" href="/riverside">Public sample tenant</a>
        </li>
        <li>
          <a class="underline" href="/login">Sign in</a>
        </li>
      </ul>
    </main>
  </body>
</html>
