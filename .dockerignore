# Dependencies (reinstalled / copied inside the image)
node_modules

# Build output (rebuilt in the image)
dist
.astro

# Secrets — inject at runtime via --env-file / LXC
.env
.env.*
!.env.example

# Local SQLite databases (never bake into the image)
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data/*.db
data/*.db-*

# Runtime uploads (mount a volume instead)
public/uploads
public/uploads/**
!public/uploads/.gitkeep

# Git / IDE / OS
.git
.gitignore
.vscode
.idea
.DS_Store

# Logs
npm-debug.log*
*.log

# Cursor / agent artifacts
.cursor
.cursorrules

# Docs not needed in the image
README.md
docs
