# Dependencies (reinstalled / copied inside the image)
node_modules

# Build output (rebuilt in the image)
dist
.astro

# Runtime uploads (mount a volume instead of baking them into the image)
public/uploads
!public/uploads/.gitkeep

# Git
.git
.gitignore

# Secrets and local env — inject at runtime
.env
.env.*
!.env.example

# IDE / OS
.vscode
.idea
.DS_Store

# Logs
npm-debug.log*
*.log

# Cursor / agent artifacts
.cursor
.cursorrules

# Docs not needed in the image
README.md
